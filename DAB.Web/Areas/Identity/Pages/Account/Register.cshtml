@page
@model RegisterModel
@{
    ViewData["Title"] = "Add Account";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-5">
        <div class="fintech-card p-5">
            <div class="text-center mb-4">
                <h2 class="fw-bold text-primary">Add New Account</h2>
                <p class="text-muted">Create a new DAB System user account</p>
            </div>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Solde" class="form-control" type="number" step="0.01" min="0" aria-required="true" placeholder="0.00" />
                    <label asp-for="Input.Solde">Initial Balance (€)</label>
                    <span asp-validation-for="Input.Solde" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <select asp-for="Input.Type" class="form-select" aria-required="true">
                        <option value="1">Courant (Checking)</option>
                        <option value="2">Épargne (Savings)</option>
                    </select>
                    <label asp-for="Input.Type">Account Type</label>
                    <span asp-validation-for="Input.Type" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.Password">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-4">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <button id="registerSubmit" type="submit" class="w-100 btn btn-primary py-2 shadow-sm">Add Account</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
