@model DAB.Web.Models.Dab
@{
    ViewData["Title"] = "ATM Logs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0 text-dark">Logs for @Model.DABId</h4>
        <p class="text-muted mb-0">Activity summary for this ATM</p>
    </div>
    <a href="/Dabs" class="btn btn-outline-primary">Back to list</a>
</div>

<div class="fintech-card p-4">
    <div class="mb-3">
        <div class="d-flex align-items-center gap-2 text-muted">
            <i class="bi bi-geo-alt"></i>
            <span>@Model.Localisation</span>
        </div>
    </div>
    <div class="mb-3">
        <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
            @(Model.IsActive ? "Online" : "Offline")
        </span>
    </div>
    <p class="text-muted mb-0">No log entries available yet.</p>
</div>
