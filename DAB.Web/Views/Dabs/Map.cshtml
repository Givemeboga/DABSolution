@model IReadOnlyList<DAB.Web.Models.Dab>
@{
    ViewData["Title"] = "ATM Map";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0 text-dark">ATM Map View</h4>
        <p class="text-muted mb-0">Locations of all distributed ATMs</p>
    </div>
    <a href="/Dabs" class="btn btn-outline-primary">Back to list</a>
</div>

<div class="fintech-card p-4">
    <div class="table-responsive">
        <table class="table table-fintech table-hover">
            <thead>
                <tr>
                    <th>ATM</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th>Accounts</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dab in Model)
                {
                    <tr>
                        <td class="fw-bold">@dab.DABId</td>
                        <td>@dab.Localisation</td>
                        <td>
                            <span class="badge @(dab.IsActive ? "bg-success" : "bg-secondary")">
                                @(dab.IsActive ? "Online" : "Offline")
                            </span>
                        </td>
                        <td>@dab.AccountsCount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
