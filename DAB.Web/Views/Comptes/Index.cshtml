@model List<DAB.Web.Models.Compte>
@{
    ViewData["Title"] = "Accounts Overview";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">My Accounts</h4>
    <a href="#" class="btn btn-primary shadow-sm"><i class="bi bi-plus-lg me-2"></i>Add Account</a>
</div>

<div class="fintech-card">
<div class="table-responsive">
    <table class="table table-fintech table-hover">
            <thead>
                <tr>
                    <th>Account Info</th>
                    <th>Account Holder</th>
                    <th>Type</th>
                    <th>Balance</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var compte in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="bg-primary text-white rounded p-2 me-3">
                                    <i class="bi bi-wallet2"></i>
                                </div>
                                <div>
                                    <span class="d-block fw-bold">@compte.NumeroCompte</span>
                                    <span class="text-muted small">@(compte.Banque?.Nom ?? "Unknown Bank")</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="fw-semibold">@compte.Proprietaire</span>
                        </td>
                        <td>
                            <span class="badge @(compte.Type == 0 ? "bg-success" : "bg-primary") text-white status-badge">
                                @(compte.Type == 0 ? "Epargne" : "Courant")
                            </span>
                        </td>
                        <td>
                            <span class="fs-5 fw-bold text-dark">€ @compte.Solde.ToString("N2")</span>
                        </td>
                        <td class="text-end">
                            <a href="#" class="btn btn-sm btn-light text-primary me-2"><i class="bi bi-eye"></i></a>
                            <form asp-action="Delete" asp-route-id="@compte.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this account?');">
                                <button type="submit" class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No accounts found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
