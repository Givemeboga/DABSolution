@{
    ViewData["Title"] = "Banks & Partners";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0 text-dark">Registered Banks</h4>
        <p class="text-muted mb-0">Institutions connected to your DAB network</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-md-6 col-xl-4">
        <div class="fintech-card h-100 position-relative border-start border-4 border-primary">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary text-white rounded p-3 text-center" style="width: 56px;">
                        <i class="bi bi-bank fs-4 mb-0"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">Banque de Paris</h5>
                        <span class="badge bg-light text-dark border">Code: 1001</span>
                    </div>
                </div>
            </div>
            
            <div class="my-4">
                <div class="d-flex align-items-center gap-2 mb-2 text-muted">
                    <i class="bi bi-geo-alt"></i>
                    <span>10 Avenue Champs, Paris</span>
                </div>
                <div class="d-flex align-items-center gap-2 text-muted">
                    <i class="bi bi-envelope"></i>
                    <span>contact@banqueparis.fr</span>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                <span class="fw-bold text-dark"><i class="bi bi-people me-2"></i>2 Accounts registered</span>
                <button class="btn btn-outline-primary btn-sm rounded-pill">View Details</button>
            </div>
        </div>
    </div>
</div>
