@model List<DAB.Web.Models.Transaction>
@{
    ViewData["Title"] = "Transactions";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">Transaction History</h4>
    @if (User.IsInRole("User"))
    {
        <div>
            <a href="/Transactions/Retrait" class="btn btn-outline-danger shadow-sm me-2"><i class="bi bi-box-arrow-up-right me-2"></i>Withdrawal</a>
            <a href="/Transactions/Transfert" class="btn btn-primary shadow-sm"><i class="bi bi-send me-2"></i>Transfer</a>
        </div>
    }
</div>

<div class="fintech-card">
<!-- Timeline Style Transactions -->
<div class="table-responsive pt-2">
    <table class="table table-hover table-fintech align-middle mb-0">
            <tbody>
                @foreach (var tx in Model.OrderByDescending(t => t.Date))
                {
                    <tr>
                        <td style="width: 60px;">
                            @if (tx.TransactionType == "Transfert")
                            {
                                <div class="bg-primary text-white p-3 rounded-circle d-flex align-items-center justify-content-center mx-auto" style="width: 48px; height: 48px;">
                                    <i class="bi bi-send fs-5"></i>
                                </div>
                            }
                            else
                            {
                                <div class="bg-danger text-white p-3 rounded-circle d-flex align-items-center justify-content-center mx-auto" style="width: 48px; height: 48px;">
                                    <i class="bi bi-cash fs-5"></i>
                                </div>
                            }
                        </td>
                        <td>
                            @if (tx.TransactionType == "Transfert")
                            {
                                <div class="fw-bold text-dark">Transfer</div>
                                <div class="text-muted small">To: @tx.NumeroCompteDestination (From Account: @tx.CompteId)</div>
                            }
                            else
                            {
                                <div class="fw-bold text-dark">ATM Withdrawal</div>
                                <div class="text-muted small">From Account: @tx.CompteId @(tx.AutreAgence == true ? "(Other Agency)" : "")</div>
                            }
                        </td>
                        <td>
                            <div class="text-muted">@tx.Date.ToString("g")</div>
                        </td>
                        <td class="text-end">
                            <div class="fs-5 fw-bold text-dark">- € @tx.Montant.ToString("N2")</div>
                            <div class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1 mt-1">Completed</div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">No transactions found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
